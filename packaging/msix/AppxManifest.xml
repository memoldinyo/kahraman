<?xml version="1.0" encoding="utf-8"?>
<!-- Paketbeschreibung für den Microsoft Store. build-msix.ps1 ersetzt die $...$-Platzhalter
     (Identität und reservierter App-Name aus identity.json, Version aus Kahraman.csproj). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>$DisplayName$</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Kahraman – the time tracker that asks</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="de-DE" />
    <Resource Language="tr-TR" />
    <Resource Language="fr-FR" />
    <Resource Language="it-IT" />
    <Resource Language="ar-SA" />
    <Resource Language="zh-CN" />
    <Resource Language="ru-RU" />
  </Resources>

  <Applications>
    <Application Id="Kahraman" Executable="Kahraman.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="$DisplayName$"
        Description="Kahraman – the time tracker that asks"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Autostart: nach dem ersten Start eingeschaltet, abschaltbar unter Einstellungen › Apps › Autostart. -->
        <desktop:Extension Category="windows.startupTask" Executable="Kahraman.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="KahramanStartup" Enabled="true" DisplayName="Kahraman" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
